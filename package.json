{
  "name": "alpha-centauri",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend",
    "preview": "npm run preview -w frontend",
    "format": "npm run format -w frontend",
    "format:check": "npm run format:check -w frontend",
    "dev:api": "npm run dev -w backend",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test:api": "npm test -w backend",
    "typecheck:api": "npm run typecheck -w backend && npm run typecheck -w infra",
    "deploy": "npm run deploy -w infra"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
